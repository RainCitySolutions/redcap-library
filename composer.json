{
	"name" : "raincity/redcap-library",
	"description" : "Library to support working with REDCap",
	"type" : "library",
	"version" : "3.0.3",
	"license" : "BSD-3-Clause",
	"minimum-stability" : "stable",
	"repositories" : [{
			"type" : "git",
			"url" : "https://github.com/RainCitySolutions/rcs-wp-library",
			"name" : "rcs-wp-library"
		}
	],
	"config" : {
		"allow-plugins" : {
			"composer/installers": true,
			"phpstan/extension-installer": true,
			"php-http/discovery": true
		}
	},
	"require" : {
		"php" : ">=8.2",
		"composer/installers" : "~2.3",
		"iu-redcap/phpcap" : "~1.5",
		"symfony/lock": "~7.4",
		"raincity/rcs-wp-library" : "~1.0"
	},
	"require-dev" : {
		"phpunit/phpunit" : "~11.5",
		"brain/monkey" : "~2.6",
		"phpstan/phpstan" : "~2.1",
		"phpstan/extension-installer" : "~1.4",
		"phpstan/phpstan-deprecation-rules": "^2.0"
	},
	"autoload" : {
		"classmap" : [
			"src/"
		],
		"psr-4" : {
			"RainCity\\REDCap\\" : "src/RainCity/REDCap",
			"IU\\PHPCap\\" : "src/IU/PHPCap"
		}
	},
	"autoload-dev" : {
		"classmap" : [
			"test/"
		],
		"psr-4" : {
			"RainCity\\REDCap\\" : "test/RainCity/REDCap"
		}
	}
}
